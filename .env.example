# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (อย่า commit .env.local)

# Supabase: Connect > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# LINE Developers Console
LINE_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# สุ่มยาว 32 ตัวขึ้นไป เช่น  openssl rand -base64 48
SESSION_SECRET=

# ใช้ในขั้น 3 และ 4 (หน้า admin และหน้าประกาศผล) สุ่มแยกกันสองตัว
ADMIN_TOKEN=
RESULTS_TOKEN=

# เฉพาะตอนพัฒนาบนเครื่อง: login ปลอมโดยไม่ผ่าน LINE (ไม่มีผลบน Vercel)
NEXT_PUBLIC_DEV_FAKE_LOGIN=1

# ไม่บังคับ
# DATABASE_SSL=disable   ปิด SSL (Postgres บนเครื่องตัวเองปิดให้อัตโนมัติอยู่แล้ว)
# DATABASE_CA=           PEM ของ Supabase CA เพื่อตรวจ certificate เต็มรูปแบบ
